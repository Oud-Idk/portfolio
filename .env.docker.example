# Copy to `.env` (or pass with `docker compose --env-file .env.local up --build`).
# `.env` and `.env.local` are both gitignored — keep tokens out of version control.

# --- Build-time (inlined into the client bundle by Next.js) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# --- Runtime, server-only ---
# Read-only token used for Sanity server-side queries (ISR / drafts).
SANITY_API_TOKEN=

# --- Cloudflare ---
# Token for the Named Tunnel serving this site.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Host ---
# Published host port for the web container. The container always listens on 3000;
# only this side moves. The deploy server needs 8090 because 8080 is taken there.
WEB_HOST_PORT=8080

# Canonical origin, used for absolute OG/image URLs in metadata.
NEXT_PUBLIC_SITE_URL=https://oud-idk.dev
